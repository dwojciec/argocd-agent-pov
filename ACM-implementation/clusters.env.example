# Copy to clusters.env (do not commit real cluster names if sensitive):
#   cp ACM-implementation/clusters.env.example ACM-implementation/clusters.env
#
# Load together with envsubst.env before running scripts:
#   set -a && source envsubst.env && source ACM-implementation/clusters.env && set +a

# ACM ManagedClusterSet bound into the GitOps namespace (must match your hub labels).
export CLUSTER_SET_NAME=poc-acm

# Hub namespace for GitOpsCluster, Placement, and hub-side Applications (ACM path).
export GITOPS_NAMESPACE=openshift-gitops

# Git source for OpenShift-compatible demo workloads (this repository by default).
export GIT_REPO_URL=https://github.com/dwojciec/argocd-agent-pov.git
export GIT_TARGET_REVISION=main
export WORKLOAD_PATH_KUSTOMIZE=ACM-implementation/workloads/openshift-demo
export WORKLOAD_PATH_HELM=ACM-implementation/workloads/openshift-demo-helm

# --- Agent mode selection ---
# Comma-separated hub cluster secret names (ManagedCluster metadata.labels.name).
# Leave empty to skip that mode entirely.

# Managed mode: Applications are defined on the hub; hub is source of truth.
export MANAGED_SPOKE_CLUSTERS=managed-cluster
# First entry used by non-ACM sample templates (sample-application-managed-cluster1.yaml.template)
export MANAGED_SPOKE_CLUSTER=managed-cluster

# Autonomous mode: Applications are defined on each spoke; surfaced to the hub.
export AUTONOMOUS_SPOKE_CLUSTERS=autonomous-cluster

# Optional second managed spoke (example for multi-cluster tests):
# export MANAGED_SPOKE_CLUSTERS=managed-cluster,workload-cluster-2

# Target namespaces on spokes for PoV demo Applications.
export MANAGED_DEMO_NAMESPACE=demo-managed
export AUTONOMOUS_DEMO_NAMESPACE=demo-autonomous
